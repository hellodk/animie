# KubeQuest — production environment
# Copy to prod.env and edit before deploying. prod.env is gitignored.

ENVIRONMENT=prod
NODE_ENV=production
WEB_MODE=prod

# Change to the actual server hostname / IP so clients can reach the server
BIND_ADDRESS=0.0.0.0
NEXT_HOSTNAME=0.0.0.0

SERVER_PORT=3001
WEB_PORT=3000

CLIENT_URL=http://YOUR_SERVER_IP:3000
NEXT_PUBLIC_SOCKET_URL=http://YOUR_SERVER_IP:3001
