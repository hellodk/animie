# KubeQuest — dev environment defaults
# Copy to dev.env and edit as needed. dev.env is gitignored.

ENVIRONMENT=dev
NODE_ENV=development
WEB_MODE=dev

BIND_ADDRESS=0.0.0.0
NEXT_HOSTNAME=0.0.0.0

SERVER_PORT=3001
WEB_PORT=3000

# Derived; override if server and web run on different hosts
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
